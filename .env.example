# Copy to .env for development. Never commit .env.
PROJECT_NAME=TypeAtlas
# Production requires a random value of at least 50 characters.
SECRET_KEY=development-only-change-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://typeatlas:password@localhost:5432/typeatlas
# DJANGO_SETTINGS_MODULE=config.settings.prod
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@localhost
# TYPEATLAS_DATA_DIR: optional desktop testing data directory; normally unset.
# REDIS_URL=redis://127.0.0.1:6379/0
# POSTGRES_PASSWORD: set a strong secret for compose; no default supplied.
